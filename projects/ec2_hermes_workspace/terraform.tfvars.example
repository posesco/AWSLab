aws_region            = "eu-west-1"
project               = "hermes"
enable_ssh_access     = false

# Prefer SSM Session Manager or Cloudflare Tunnel. If direct SSH is required,
# set enable_ssh_access = true and use a narrow trusted source CIDR.
allowed_ssh_cidr_ipv4 = "203.0.113.10/32"
allowed_ssh_cidr_ipv6 = "2001:db8::/128"

instance_type = {
  dev     = "t4g.small"
  staging = "t4g.medium"
  prod    = "t4g.large"
}

key_name = {
  dev     = "your-key-dev"
  staging = "your-key-staging"
  prod    = "your-key-prod"
}

lab_volume_size = {
  dev     = 30
  staging = 50
  prod    = 50
}

cloudflare_tunnel_token_parameter_name = {
  dev     = "/hermes/dev/cloudflare_token"
  staging = "/hermes/staging/cloudflare_token"
  prod    = "/hermes/prod/cloudflare_token"
}
